{
  "name": "scaneur",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "scaneur",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20.18"
      }
    },
    "apps/docs": {
      "name": "@scaneur/docs",
      "version": "0.0.0",
      "license": "MIT"
    },
    "node_modules/@scaneur/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@scaneur/docs": {
      "resolved": "apps/docs",
      "link": true
    },
    "node_modules/@scaneur/reports": {
      "resolved": "packages/reports",
      "link": true
    },
    "node_modules/@scaneur/rules": {
      "resolved": "packages/rules",
      "link": true
    },
    "node_modules/@scaneur/scanner": {
      "resolved": "packages/scanner",
      "link": true
    },
    "node_modules/@scaneur/types": {
      "resolved": "packages/types",
      "link": true
    },
    "packages/cli": {
      "name": "@scaneur/cli",
      "version": "0.0.0",
      "license": "MIT",
      "dependencies": {
        "@scaneur/reports": "0.0.0",
        "@scaneur/rules": "0.0.0",
        "@scaneur/scanner": "0.0.0",
        "@scaneur/types": "0.0.0"
      },
      "bin": {
        "scaneur": "src/index.js"
      }
    },
    "packages/reports": {
      "name": "@scaneur/reports",
      "version": "0.0.0",
      "license": "MIT",
      "dependencies": {
        "@scaneur/types": "0.0.0"
      }
    },
    "packages/rules": {
      "name": "@scaneur/rules",
      "version": "0.0.0",
      "license": "MIT",
      "dependencies": {
        "@scaneur/types": "0.0.0"
      }
    },
    "packages/scanner": {
      "name": "@scaneur/scanner",
      "version": "0.0.0",
      "license": "MIT",
      "dependencies": {
        "@scaneur/rules": "0.0.0",
        "@scaneur/types": "0.0.0"
      }
    },
    "packages/types": {
      "name": "@scaneur/types",
      "version": "0.0.0",
      "license": "MIT"
    }
  }
}
